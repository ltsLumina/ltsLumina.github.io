<?xml version="1.0" encoding="UTF-8"?>
<buildprofiles xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="https://resources.jetbrains.com/writerside/1.0/build-profiles.xsd">
    <sitemap priority="0.5" change-frequency="weekly"/>

    <variables>
        <product-web-url>https://alexanderseguin.com/portfolio.html</product-web-url>
        <code-soft-wrap>true</code-soft-wrap>
        <custom-banner label="" link="https://www.linkedin.com/in/itslumina/" date="" bg-theme="strawberry">Open to Internships</custom-banner>
        <web-root>https://alexanderseguin.com</web-root>
        <webmaster>itsluminas@gmail.com</webmaster>
        
        <!-- FEEDBACK -->
        <feedback-widget>false</feedback-widget>
        <config-feedback-require-email>false</config-feedback-require-email>
        <feedback-recaptcha-enabled>false</feedback-recaptcha-enabled>
        
        <primary-color>ruby</primary-color>
        <color-preset>contrast</color-preset>
        <link-color>aqua</link-color>
        <content-max-width>1280</content-max-width>
        <custom-favicons>favicon.png</custom-favicons>
        <header-logo>favicon.png</header-logo>
        <download-title>Reach out!</download-title>
        <download-page>https://www.linkedin.com/in/itslumina</download-page>
        <showDownloadButton>true</showDownloadButton>
        <sidebar-width>200</sidebar-width>
        <resizable-sidebar>false</resizable-sidebar>
        <noindex-content>false</noindex-content>
    </variables>
    
    <footer>
        <copyright>2026 Alexander Andrejeff.</copyright>
        <social type="youtube" href="https://www.youtube.com/@ItsLumina"/>
        <social type="instagram" href="https://instagram.com/korv.stroganof/">
            Personal Instagram account.
        </social>
<!--        <social type="twitter" href="https://twitter.com/ltsLumina"/>-->
        <social type="discord" href="https://discordapp.com/users/287272193946288129">
            Personal and Business Discord.
        </social>
        <social type="github" href="https://github.com/ltsumina"/>
        <social type="linkedin" href="https://www.linkedin.com/in/itslumina"/>
        <social type="email" href="itsluminas@gmail.com"/>
        <link href="https://alexanderseguin.com/about-me.html">
            Made by a Human
        </link>
    </footer>
    
    <build-profile instance="pf">
        <variables>
            <noindex-content>false</noindex-content>
            <og-image>https://raw.githubusercontent.com/ltsLumina/ltsLumina.github.io/refs/heads/main/portfolio-embed.png</og-image>
            <product-web-url>https://alexanderseguin.com/portfolio.html</product-web-url>
        </variables>
    </build-profile>

</buildprofiles>
